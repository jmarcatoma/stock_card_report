<odoo>
    <record id="view_select_category_wizard_form" model="ir.ui.view">
        <field name="name">stock.card.select.category.wizard.form</field>
        <field name="model">stock.card.select.category.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Product Categories">
                <group>
                    <field name="category_ids"/>
                </group>
                <footer>
                    <button name="apply_selected_categories" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>