<odoo>

    <record id="stock_card_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.card.report.wizard.form</field>
        <field name="model">stock.card.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group name="criteria">
                    <group>
                        <field name="date_range_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="consolidated"/>
                        <field name="show_lot"/>
                        <field name="group_by_lot"/>
                        <field name="group_by_location"/>
                        <field name="show_partner"/>
                        <field name="include_sublocations"/>
                        <field name="only_accounted_moves"/>
                        <field name="sku_type"/>
                        <field name="allow_virtual_locations"/>
                    </group>
                    <group>
                        <field name="categ_ids"
                                widget="many2many_tags"
                                options="{'no_create': 1, 'no_open': 1}"
                                class="oe_inline"/>
                        <button name="action_open_category_selector"
                            string="Add Categs"
                                    type="object"
                                    class="oe_link"
                                    icon="fa-plus"
                                    style="margin-left:10px"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="filter_location_ids"
                               options="{'no_create': 1, 'no_open': 1}"
                               widget="many2many_tags" invisible="1"/>
                        <field name="location_ids" widget="many2many_tags" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="filter_lot_ids"
                               options="{'no_create': 1, 'no_open': 1}"
                               widget="many2many_tags" invisible="1"/>
                        <field name="lot_ids" widget="many2many_tags" options="{'no_create': 1, 'no_open': 1}"/>
                        <field name="code_from"/>
                        <field name="code_to"/>
                    </group>
                </group>
                <footer>
                    <button name="button_export_html" string="View"
                            type="object" default_focus="1" class="oe_highlight"/>
                    or
                    <button name="button_export_pdf" string="Export PDF" type="object"/>
                    or
                    <button name="button_export_xlsx" string="Export XLSX" type="object"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_card_report_action" model="ir.actions.act_window">
        <field name="name">Stock Card</field>
        <field name="res_model">stock.card.report.wizard</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="stock_card_report_menu"
              action="stock_card_report_action"
              parent="stock.menu_warehouse_report"
              sequence="30"/>

</odoo>
